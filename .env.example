# Copy this to .env in the same directory as the cm binary, or in your
# current working directory, or in cm's state dir (see CM_STATE_DIR below;
# on macOS that's ~/Library/Application Support/net.eternalvoid.cm/).
# Real environment variables always win over any .env file.

# Base URL of your Mirror server's OpenAI-compatible API.
CM_BASE_URL=http://localhost:8799

# Bearer token cm sends to Mirror. Usually you don't need to set CM_API_KEY
# at all: cm already reads Mirror's own MIRROR_API_KEY / MIRROR_API_KEYS env
# vars directly (same ones the mirror-app server reads), and falls back to
# OPENAI_API_KEY if neither is set. Only set CM_API_KEY if you want cm to use
# a different key than the rest of Mirror.
CM_API_KEY=
# MIRROR_API_KEY=
# MIRROR_API_KEYS=
# OPENAI_API_KEY=

# Default model / gizmo / project id. "auto" lets Mirror pick.
CM_MODEL=auto

# Default thread name, if you want something other than "default".
CM_THREAD=default

# Set to 0/false/no to disable streaming by default (can still override
# per-call with --no-stream).
CM_STREAM=true

# Where cm stores its per-thread conversation ids. Defaults to the OS
# standard app-data location if unset.
# CM_STATE_DIR=/home/you/.local/share/cm
